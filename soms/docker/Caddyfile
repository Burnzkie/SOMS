# docker/Caddyfile
# Roadmap Phase 2.1 — minimal FrankenPHP config: serve Laravel's public/
# directory, bind to Render's injected $PORT, run PHP through the built-in
# php_server directive (php-fpm-equivalent, handled internally by
# FrankenPHP — no separate FPM process to manage).

{
	auto_https off
	admin off

	# Deploy-readiness fix (Sep 2026): FrankenPHP defaults to 2x CPU cores,
	# which is unbounded from this file's point of view and was previously
	# not enforced anywhere despite SystemHealthController documenting an
	# assumed "pooled max: 4" against Clever Cloud's hard 5-connection cap.
	# Each PHP thread can hold its own DB connection, so pin this web
	# service to 4 threads -- leaving exactly 1 connection of headroom for
	# the separate soms-queue-worker service (render.yaml), which holds 1.
	# 4 (web) + 1 (worker) = 5 = the cap, with zero spare margin, so this
	# number must move in lockstep with render.yaml if the worker service
	# is ever scaled beyond a single instance.
	frankenphp {
		num_threads 4
	}
}

:{$PORT} {
	root * /var/www/html/public
	encode gzip

	# Deploy-readiness fix (Sep 2026): removed a custom `@notFound not_found`
	# matcher block that was here. `not_found` isn't a real Caddy matcher
	# module, so this failed config validation outright ("module not
	# registered: http.matchers.not_found") -- it just hadn't surfaced yet
	# because the setcap/exec issue was killing the deploy before Caddy got
	# this far. It also wasn't needed: php_server below already does the
	# standard Laravel front-controller dance on its own (serve the file if
	# it exists on disk, otherwise route to index.php) -- this is the
	# officially documented minimal FrankenPHP+Laravel Caddyfile
	# (https://frankenphp.dev/docs/laravel/). A blanket "no file? respond
	# 404" placed before php_server would have caught nearly every real
	# Laravel route (none of them are actual files on disk) and returned a
	# bare Caddy 404 instead of ever reaching Laravel's own router --
	# Laravel's exception handler already returns proper 404s for routes
	# that genuinely don't exist.
	php_server
}
